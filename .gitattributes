# Canonicalize line endings so Windows git (autocrlf) and WSL git agree. Without this,
# a Windows checkout writes CRLF and WSL tools (Unio workers, the lead) see every touched
# file as "modified". The repo stores LF; text files are checked out LF everywhere.
* text=auto eol=lf

# Windows-native scripts keep CRLF — their interpreters expect it.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Text formats that should always diff as text (never guessed binary).
*.svg text
*.astro text
*.spec text
*.iss text

# Binary assets — never normalize, diff, or merge as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.icns binary
*.ttf  binary
*.otf  binary
*.ai   binary
*.pdf  binary
*.wav  binary
*.mp3  binary
*.zip  binary
*.exe  binary
*.dll  binary
*.dmg  binary
*.AppImage binary
